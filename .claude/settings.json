{
  "permissions": {
    "allow": [
      "Bash(boilerplate/_lib/container-make)",
      "Bash(boilerplate/_lib/container-make *)",
      "Bash(cat *)",
      "Bash(find *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr create *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(git add *)",
      "Bash(git branch *)",
      "Bash(git checkout -- *)",
      "Bash(git checkout -b *)",
      "Bash(git diff *)",
      "Bash(git fetch *)",
      "Bash(git log *)",
      "Bash(git remote *)",
      "Bash(git show *)",
      "Bash(git stash *)",
      "Bash(git status *)",
      "Bash(go build *)",
      "Bash(go fmt *)",
      "Bash(go mod tidy)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(gofmt *)",
      "Bash(goimports *)",
      "Bash(grep *)",
      "Bash(gsutil cat *)",
      "Bash(gsutil ls *)",
      "Bash(head *)",
      "Bash(ls *)",
      "Bash(make *)",
      "Bash(prek *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git commit -n)",
      "Bash(git commit -n *)",
      "Bash(git commit --no-verify)",
      "Bash(git commit --no-verify *)",
      "Bash(git push *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push * --force-with-lease)",
      "Bash(git push * --force-with-lease *)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push --force-with-lease)",
      "Bash(git push --force-with-lease *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(kubectl *)",
      "Bash(make docker-build)",
      "Bash(oc *)"
    ],
    "deny": [
      "Bash(chmod 777 *)",
      "Bash(rm -rf /)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/session-start-prek-setup.sh\"",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/stop-prek-validation.sh\""
          }
        ]
      }
    ]
  }
}
